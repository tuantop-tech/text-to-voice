# Bắt buộc: chuỗi bí mật để ký session (đổi thành chuỗi ngẫu nhiên dài)
SESSION_SECRET=change-this-to-a-long-random-secret

# ElevenLabs - clone giọng & TTS tiếng Việt. Để trống = chế độ demo (tiếng beep)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# DeepSeek (OpenAI-compatible) - viết lại kịch bản & gợi ý trả lời. Để trống = demo
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Thư mục lưu file audio & mẫu giọng
DATA_DIR=./data
